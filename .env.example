# Required. The collection lives in Supabase; the app keeps a mirror of it on the
# device so it works offline, but there is nothing to mirror without these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local only — used by `npm run seed:cloud` to populate a fresh database once.
# This key bypasses row-level security. Never prefix it NEXT_PUBLIC_, and never
# put it in Vercel.
SUPABASE_SERVICE_ROLE_KEY=
